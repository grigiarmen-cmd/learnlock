<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LearnLock_App.Views.LockScreenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="System Blocked">

    <Grid Background="#0f0f0f">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Clock/Date Display (Logon screen style) -->
        <StackPanel Margin="0,50,0,0" HorizontalAlignment="Center" Spacing="8">
            <TextBlock x:Name="ClockText" 
                       Text="12:00" 
                       FontSize="72" 
                       FontWeight="Light" 
                       Foreground="#2D3748" 
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="DateText" 
                       Text="Donnerstag, 1. Januar" 
                       FontSize="18" 
                       Foreground="#cccccc" 
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Center challenge block -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="40">
            <!-- Left Side: Avatars and Challenge -->
            <StackPanel Spacing="24" VerticalAlignment="Center">
            <StackPanel Spacing="16" Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Locky AI Avatar -->
                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#FDFBF7" BorderBrush="#81c784" BorderThickness="2">
                        <TextBlock Text="🤖" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    </Border>
                    <TextBlock Text="Locky KI" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Child Avatar -->
                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#FDFBF7" BorderBrush="#3d3d3d" BorderThickness="2">
                        <FontIcon Glyph="&#xE77b;" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="#F97316" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ChildNameText" Text="Kind" FontSize="12" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Challenge Box -->
            <Border BorderThickness="1" 
                    BorderBrush="#252525" 
                    Background="#161616" 
                    CornerRadius="16" 
                    Padding="24" 
                    Width="540"
                    MaxWidth="600"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    
                    <TextBlock x:Name="SubjectLabel" 
                               Text="FACH: MATHEMATIK" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Foreground="#F97316" 
                               HorizontalAlignment="Center" 
                               CharacterSpacing="100"/>

                    <TextBlock x:Name="EquationText" 
                               Text="8 + 4 = ?" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="490"
                               Foreground="#2D3748"/>

                    <!-- Options list for Multiple Choice general knowledge -->
                    <StackPanel x:Name="OptionsPanel" Spacing="8" Visibility="Collapsed"/>

                    <TextBox x:Name="AnswerInput" 
                             PlaceholderText="Antwort eingeben" 
                             FontSize="16" 
                             TextAlignment="Center" 
                             KeyDown="AnswerInput_KeyDown"
                             Height="42"
                             Background="#FDFBF7" 
                             BorderBrush="#E2E8F0" 
                             Foreground="#2D3748"
                             VerticalContentAlignment="Center"
                             CornerRadius="6"/>

                    <Button x:Name="VerifyButton"
                            Content="Prüfen &amp; Anmelden" 
                            Background="#F97316" 
                            Foreground="#000000"
                            FontWeight="Bold"
                            HorizontalAlignment="Stretch" 
                            Click="VerifyAnswer_Click"
                            Height="40"
                            FontSize="14"
                            CornerRadius="6"/>

                    <TextBlock x:Name="ProgressLabel" 
                               Text="Fortschritt: 0 / 20 Aufgaben gelöst" 
                               FontSize="11" 
                               Foreground="#718096" 
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="FeedbackText" 
                               HorizontalAlignment="Center" 
                               Visibility="Collapsed"
                               FontWeight="Bold"
                               FontSize="13"/>
                </StackPanel>
            </Border>
        </StackPanel>
            <!-- Right Side: Locky KI Chat (Visible for Pro/Ultra) -->
            <Border x:Name="LockyChatBorder" 
                    BorderThickness="1" 
                    BorderBrush="#2c2e35" 
                    Background="#202228" 
                    CornerRadius="12" 
                    Padding="20" 
                    Width="360"
                    Height="400"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Locky KI Chat" FontSize="18" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="Stell mir eine Frage, wenn du nicht weiterkommst. Ich helfe dir mit Tipps, verrate aber nicht die Lösung!" FontSize="11" Foreground="#718096" TextWrapping="Wrap"/>
                        <Border Height="1" Background="#333333" Margin="0,4,0,4"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,10,0,10">
                        <ItemsControl x:Name="ChatMessagesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1a1a1a" CornerRadius="8" Padding="10" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding}" Foreground="#2D3748" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInputBox" PlaceholderText="Frag Locky..." Background="#1a1a1a" BorderBrush="#E2E8F0" Foreground="#2D3748" KeyDown="ChatInputBox_KeyDown"/>
                        <Button Grid.Column="1" Content="Senden" Click="SendChat_Click" Background="#10B981" Foreground="#121212" FontWeight="Bold" CornerRadius="6"/>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Bottom Emergency Override -->
        <Border Grid.Row="2" 
                BorderThickness="1,1,1,0" 
                BorderBrush="#252525" 
                Background="#161616" 
                CornerRadius="12,12,0,0" 
                Padding="16" 
                Width="380" 
                HorizontalAlignment="Center"
                Margin="0,0,0,-2">
            <StackPanel Spacing="8">
                <TextBlock Text="Eltern-Override (Entsperrung)" 
                           FontSize="11" 
                           FontWeight="SemiBold"
                           Foreground="#718096"
                           HorizontalAlignment="Center"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ParentPasswordInput" 
                                 PlaceholderText="Eltern-Passwort"
                                 KeyDown="ParentPasswordInput_KeyDown"
                                 Background="#FDFBF7"
                                 BorderBrush="#E2E8F0"
                                 Foreground="#2D3748"
                                 Height="36"
                                 CornerRadius="6"/>
                    <Button Grid.Column="1" 
                            Content="Dashboard öffnen" 
                            Click="ParentUnlock_Click"
                            Background="#F97316"
                            Foreground="#FFFFFF"
                            FontWeight="Bold"
                            Height="36"
                            CornerRadius="6"/>
                </Grid>
                <TextBlock x:Name="ParentErrorText" 
                           Text="Ungültiges Eltern-Passwort!" 
                           Foreground="#EF4444" 
                           FontSize="11" 
                           HorizontalAlignment="Center" 
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>


