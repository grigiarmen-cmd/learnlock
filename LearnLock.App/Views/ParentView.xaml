<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LearnLock_App.Views.ParentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="#070C16">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 🌌 Left Sidebar Navigation (Glowing Dark Blue Glass) -->
        <Border Grid.Column="0" Background="#0A1124" BorderBrush="#142142" BorderThickness="0,0,1,0">
            <Grid Padding="20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Spacing="6" Margin="4,0,0,32">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Learn" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Lock" FontSize="24" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                    <TextBlock Text="Lernen wird zur Belohnung!" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <!-- 1. Dashboard Tab -->
                    <Button x:Name="TabDashboard" Click="Tab_Click" Tag="Dashboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="1" BorderBrush="#38BDF8" Height="46" CornerRadius="12" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🏠" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Abonnements Tab (vormals Settings) -->
                    <Button x:Name="TabSettings" Click="Tab_Click" Tag="Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Height="46" CornerRadius="12" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Abonnements" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 3. Konto Tab (mit integrierten Einstellungen) -->
                    <Button x:Name="TabAccount" Click="Tab_Click" Tag="Account" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Height="46" CornerRadius="12" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Konto" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 4. Profile Tab (Kinderprofile) -->
                    <Button x:Name="TabChildren" Click="Tab_Click" Tag="Children" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Height="46" CornerRadius="12" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="👥" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Profile" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Invisible Backwards compatibility for TabAppBlocker -->
                    <Button x:Name="TabAppBlocker" Visibility="Collapsed" Tag="AppBlocker"/>
                </StackPanel>

                <!-- Sidebar Footer Trophy Banner & Logout -->
                <StackPanel Grid.Row="2" Spacing="16">
                    <Border Background="#0E1B38" BorderBrush="#1E3360" BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🏆" FontSize="18"/>
                                <TextBlock Text="BESSERE KINDER" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                            </StackPanel>
                            <TextBlock Text="HELLERE ZUKUNFT" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="Lernen. Spielen. Wachsen." FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Button Content="🚪 Abmelden" Click="Logout_Click" HorizontalAlignment="Stretch" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Foreground="#94A3B8" Height="38" CornerRadius="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 🚀 Right Content Area -->
        <Grid Grid.Column="1" Padding="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Global Top Bar (Greeting, Child Quick-Selector, Notifications, Profile Pill) -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Greeting Title (dynamically switches or welcomes parent) -->
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TopHeaderTitle" Text="Eltern-Dashboard" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TopHeaderSubtitle" Text="Guten Tag! Hier ist deine Übersicht für Familie &amp; Lernen." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Right Quick Info Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <!-- Quick Child Switcher Badge -->
                    <Border Background="#0C1730" BorderBrush="#1E3360" BorderThickness="1" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#0284C7">
                                <TextBlock x:Name="TopChildAvatarEmoji" Text="👦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TopChildQuickName" Text="Kind auswählen" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Bell Icon -->
                    <Border Width="38" Height="38" CornerRadius="19" Background="#0C1730" BorderBrush="#1E3360" BorderThickness="1">
                        <TextBlock Text="🔔" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Account Pill -->
                    <Border Background="#0C1730" BorderBrush="#1E3360" BorderThickness="1" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#38BDF8">
                                <TextBlock Text="👤" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TopAccountPillName" Text="Mein Konto" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Main Panels Container -->
            <Grid Grid.Row="1">
                <!-- ========================================== -->
                <!-- 1. 🏠 DASHBOARD PANEL (Exact Bild 1 Design) -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelDashboard" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Padding="0,0,8,30">
                        <!-- Update Banner if available -->
                        <Border x:Name="UpdateBanner" Background="#0C2548" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="14" Padding="16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="UpdateTitleText" Text="🎉 Neues Update verfügbar!" FontWeight="Bold" Foreground="#38BDF8" FontSize="14"/>
                                    <TextBlock x:Name="UpdateDescText" Text="Eine neue Version von LearnLock steht bereit." Foreground="#94A3B8" FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="InstallUpdateBtn" Content="Jetzt aktualisieren" Click="InstallUpdateBtn_Click" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="8" Height="34"/>
                            </Grid>
                        </Border>

                        <!-- Top 3 Metric Cards Row -->
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Lernfortschritt Ring -->
                            <Border Grid.Column="0" Background="#0B152E" BorderBrush="#192A4E" BorderThickness="1" CornerRadius="18" Padding="20">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="📊" FontSize="15"/>
                                            <TextBlock Text="Lernfortschritt" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <TextBlock Text="Diese Woche ▾" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Glowing Percentage Circle -->
                                        <Border Width="100" Height="100" CornerRadius="50" BorderBrush="#0284C7" BorderThickness="6" Background="#061026" HorizontalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="DashProgressText" Text="72%" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Diese Woche" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="4">
                                            <TextBlock Text="Tolle Leistung!" FontSize="14" FontWeight="Bold" Foreground="#F59E0B"/>
                                            <TextBlock Text="Dein Kind ist auf einem sehr guten Weg zu seinen Lernzielen." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Spielzeit verdient -->
                            <Border Grid.Column="1" Background="#0B152E" BorderBrush="#192A4E" BorderThickness="1" CornerRadius="18" Padding="20">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🎮" FontSize="15"/>
                                        <TextBlock Text="Spielzeit verdient" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="56" Height="56" CornerRadius="28" BorderBrush="#F59E0B" BorderThickness="3" Background="#171A29" HorizontalAlignment="Center">
                                            <TextBlock Text="⏱️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock x:Name="DashTimerText" Text="45 Min." FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="durch erfolgreiches Lernen" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="▶ Spielzeit freigeben" Click="PlayNow_Click" Background="#F59E0B" Foreground="#000000" FontWeight="Bold" FontSize="13" Height="38" CornerRadius="10" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Aktivität diese Woche (Barchart) -->
                            <Border Grid.Column="2" Background="#0B152E" BorderBrush="#192A4E" BorderThickness="1" CornerRadius="18" Padding="20">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📈" FontSize="15"/>
                                        <TextBlock Text="Aktivität diese Woche" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>

                                    <!-- Styled Mini Bar Graph -->
                                    <Grid Height="90" Margin="0,4,0,0" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mo -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                            <Border Width="16" Height="30" Background="#0284C7" CornerRadius="4"/>
                                            <TextBlock Text="Mo" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Di -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                            <Border Width="16" Height="50" Background="#0284C7" CornerRadius="4"/>
                                            <TextBlock Text="Di" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Mi -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                            <Border Width="16" Height="80" Background="#38BDF8" CornerRadius="4"/>
                                            <TextBlock Text="Mi" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Do -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                            <Border Width="16" Height="60" Background="#0284C7" CornerRadius="4"/>
                                            <TextBlock Text="Do" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Fr -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                            <Border Width="16" Height="40" Background="#0284C7" CornerRadius="4"/>
                                            <TextBlock Text="Fr" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Sa -->
                                        <StackPanel Grid.Column="5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                            <Border Width="16" Height="75" Background="#38BDF8" CornerRadius="4"/>
                                            <TextBlock Text="Sa" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- So -->
                                        <StackPanel Grid.Column="6" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                            <Border Width="16" Height="35" Background="#0284C7" CornerRadius="4"/>
                                            <TextBlock Text="So" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Middle Row: Apps & Spielzeit + Letzte Aktivitäten -->
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Box: Apps & Spielzeit -->
                            <Border Grid.Column="0" Background="#0B152E" BorderBrush="#192A4E" BorderThickness="1" CornerRadius="18" Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📱" FontSize="16"/>
                                        <TextBlock Text="Apps &amp; Spielzeit" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Freigegebene Apps -->
                                        <StackPanel Grid.Column="0" Spacing="10">
                                            <TextBlock Text="✅ Freigegebene Apps" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                                            
                                            <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="➕" FontSize="18" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="Mathe Abenteuer" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="Lernen mit Spaß" FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#064E3B" CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="Freigegeben" FontSize="10" Foreground="#34D399" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="🚀" FontSize="18" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="Code Quest" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="Programmieren" FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#064E3B" CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="Freigegeben" FontSize="10" Foreground="#34D399" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- Gesperrte Apps -->
                                        <StackPanel Grid.Column="1" Spacing="10">
                                            <TextBlock Text="🚫 Gesperrte Apps" FontSize="12" FontWeight="SemiBold" Foreground="#F43F5E"/>
                                            
                                            <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="🎮" FontSize="18" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="Battle Zone" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="Action-Spiel" FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#4C0519" CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="Gesperrt" FontSize="10" Foreground="#FB7185" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="🏎️" FontSize="18" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="Racing Pro" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="Rennspiel" FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#4C0519" CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="Gesperrt" FontSize="10" Foreground="#FB7185" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Right Box: Letzte Aktivitäten -->
                            <Border Grid.Column="1" Background="#0B152E" BorderBrush="#192A4E" BorderThickness="1" CornerRadius="18" Padding="20">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⏱️" FontSize="15"/>
                                            <TextBlock Text="Letzte Aktivitäten" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <TextBlock Text="Alle anzeigen →" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Width="28" Height="28" CornerRadius="6" Background="#0284C7">
                                                    <TextBlock Text="➗" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="Mathematik abgeschlossen" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Kapitel 'Brüche &amp; Gleichungen'" FontSize="10" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Heute 16:24" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Width="28" Height="28" CornerRadius="6" Background="#D97706">
                                                    <TextBlock Text="🏆" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="Neue Spielzeit verdient" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="15 Minuten freigeschaltet" FontSize="10" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Heute 15:10" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Width="28" Height="28" CornerRadius="6" Background="#059669">
                                                    <TextBlock Text="📖" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="Englisch-Lektion gestartet" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Vokabeln &amp; Grammatik" FontSize="10" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Heute 14:03" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Bottom Banner -->
                        <Border Background="#0A1633" BorderBrush="#1C305C" BorderThickness="1" CornerRadius="16" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🏆" FontSize="26" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Konsequentes Lernen zahlt sich aus." FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Mit LearnLock wird Bildschirmzeit zur Belohnung – für eine starke Zukunft deines Kindes." FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Mehr erfahren →" Background="#0F244C" BorderBrush="#1E3E7A" BorderThickness="1" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Height="32" CornerRadius="8"/>
                            </Grid>
                        </Border>

                        <!-- Invisible binding elements to satisfy code-behind -->
                        <TextBlock x:Name="StatTotalTimeText" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatDailyAvgText" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatActiveLimitsText" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatKeywordsText" Visibility="Collapsed"/>
                        <ItemsControl x:Name="DashActiveRulesList" Visibility="Collapsed"/>
                        <ItemsControl x:Name="DashboardChildrenList" Visibility="Collapsed"/>
                        <Button x:Name="AddProfileDashboardBtn" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================== -->
                <!-- 2. 📅 ABONNEMENTS PANEL (Exact Bild 2 Design) -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24" Padding="0,0,8,40" HorizontalAlignment="Center" MaxWidth="860">
                        <!-- Heading -->
                        <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,10,0,10">
