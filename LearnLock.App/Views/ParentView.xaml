                            <TextBlock Text="|" Foreground="#1E293B"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🔄" FontSize="14"/>
                                <TextBlock Text="Jederzeit kündbar" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="|" Foreground="#1E293B"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="⭐" FontSize="14"/>
                                <TextBlock Text="30 Tage Geld-zurück-Garantie" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 2 Big Pricing Cards (100 € Jährlich vs 250 € Lifetime) -->
                        <Grid ColumnSpacing="24" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380" />
                                <ColumnDefinition Width="380" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: PREMIUM (100 € / Jahr) -->
                            <Border Grid.Column="0" Background="#09132B" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="22" Padding="28">
                                <StackPanel Spacing="16">
                                    <Border Width="48" Height="48" CornerRadius="14" Background="#0284C7" HorizontalAlignment="Left">
                                        <TextBlock Text="⭐" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="PREMIUM" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Für aktive Familien" FontSize="12" Foreground="#64748B"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,8">
                                        <TextBlock x:Name="PriceBasic" Text="100 €" FontSize="44" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text=" pro Jahr" FontSize="14" Foreground="#64748B" Margin="6,0,0,6"/>
                                    </StackPanel>

                                    <Button Content="Premium wählen →" Click="DirectStripeCheckout_Click" Tag="Pro" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" Height="46" CornerRadius="12" HorizontalAlignment="Stretch"/>

                                    <Border Height="1" Background="#162850" Margin="0,8,0,8"/>

                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="Unbegrenzte Kinderprofile" FontSize="13" Foreground="#CBD5E1"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="Alle Schulfächer (Mathe, Deutsch...)" FontSize="13" Foreground="#CBD5E1"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="App-Sperre und Webfilter" FontSize="13" Foreground="#CBD5E1"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="Locky KI-Lern-Tutor" FontSize="13" Foreground="#CBD5E1"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="Regelmäßige Updates und Support" FontSize="13" Foreground="#CBD5E1"/></StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Right: LIFETIME (250 € Einmalig) -->
                            <Border Grid.Column="1" Background="#0A142E" BorderBrush="#EAB308" BorderThickness="2" CornerRadius="22" Padding="28">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <Border Width="48" Height="48" CornerRadius="14" Background="#EAB308" HorizontalAlignment="Left">
                                            <TextBlock Text="👑" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FEF08A" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="BESTER WERT" FontSize="10" FontWeight="Bold" Foreground="#854D0E"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="LIFETIME" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Einmal zahlen. Für immer geschützt." FontSize="12" Foreground="#64748B"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,8">
                                        <TextBlock x:Name="PriceUltra" Text="250 €" FontSize="44" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text=" einmalig" FontSize="14" Foreground="#F59E0B" FontWeight="Bold" Margin="6,0,0,6"/>
                                    </StackPanel>

                                    <Button Content="Lebenslang sichern →" Click="DirectStripeCheckout_Click" Tag="Ultra" Background="#EAB308" Foreground="#000000" FontWeight="Bold" FontSize="15" Height="46" CornerRadius="12" HorizontalAlignment="Stretch"/>

                                    <TextBlock Text="ⓘ Keine Verlängerung. Keine versteckten Kosten." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>

                                    <Border Height="1" Background="#1E3360" Margin="0,4,0,8"/>

                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" Foreground="#F59E0B" FontWeight="Bold"/><TextBlock Text="Lebenslanger Zugriff ohne Abo" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" Foreground="#F59E0B" FontWeight="Bold"/><TextBlock Text="Unbegrenzte Kinderprofile und Geräte" FontSize="13" Foreground="#CBD5E1"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" Foreground="#F59E0B" FontWeight="Bold"/><TextBlock Text="Alle Fächer, Aufgaben und KI-Funktionen" FontSize="13" Foreground="#CBD5E1"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" Foreground="#F59E0B" FontWeight="Bold"/><TextBlock Text="Priorisierter Support und Updates" FontSize="13" Foreground="#CBD5E1"/></StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Invisible helper controls for compatibility -->
                        <RadioButton x:Name="PlanFree" GroupName="Plans" Visibility="Collapsed" />
                        <TextBlock x:Name="PricePro" Visibility="Collapsed" />
                        <ToggleSwitch x:Name="SubscriptionIntervalToggle" Visibility="Collapsed" />
                        <StackPanel x:Name="StripeCheckoutPanel" Visibility="Collapsed">
                            <Button x:Name="StripeCheckoutButton" Click="StripeCheckout_Click"/>
                            <StackPanel x:Name="StripeWaitingPanel"/>
                            <TextBlock x:Name="StripeSuccessText"/>
                            <HyperlinkButton Click="FreePlan_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="SettingsSuccessText" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================== -->
                <!-- 3. 👤 KONTO PANEL (Exact Bild 3 Design mit Einstellungen integriert) -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelAccount" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="22" Padding="0,0,8,40" MaxWidth="900" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Kontoeinstellungen" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Verwalte deinen Account, dein Abo und deine App-Sicherheit." FontSize="13" Foreground="#94A3B8"/>
                        </StackPanel>

                        <!-- Top 3 Status Cards Row -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Kontostatus -->
                            <Border Grid.Column="0" Background="#0B152E" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#0284C7">
                                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#064E3B" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Aktiv" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Kontostatus" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="AccountEmailText" Text="eltern@learnlock.local" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Aktueller Plan (Highlighted Gold) -->
                            <Border Grid.Column="1" Background="#0B152E" BorderBrush="#EAB308" BorderThickness="2" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#EAB308">
                                            <TextBlock Text="👑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Content="Plan upgraden →" Click="UpgradeAccountPlan_Click" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Height="32" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Aktueller Plan" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock x:Name="AccountPlanText" Text="Free Tier (1 Kind / 1 Fach)" FontSize="16" FontWeight="Bold" Foreground="#F59E0B"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Sicherheit -->
                            <Border Grid.Column="2" Background="#0B152E" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="10">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#0284C7" HorizontalAlignment="Left">
                                        <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Sicherheit" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Dein Elternkonto ist geschützt." FontSize="12" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Box: Abo-Verwaltung -->
                        <Border Background="#0B152E" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="18" Padding="20">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📅" FontSize="16"/>
                                    <TextBlock Text="Abo-Verwaltung" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="Verwalte dein LearnLock-Abo und deine Zahlungsoptionen." FontSize="12" Foreground="#64748B"/>

                                <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="📄" FontSize="18" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Abonnement verwalten" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Zahlungen, Laufzeit und Tarif" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Content="Verwalten →" Click="CancelStripeSubscription_Click" Background="#0F244C" BorderBrush="#1E3E7A" BorderThickness="1" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" Height="34" CornerRadius="8" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="💳" FontSize="18" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Zahlungsmethode" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Sicher über Stripe verwaltet" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Content="Bearbeiten →" Click="CancelStripeSubscription_Click" Background="#0F244C" BorderBrush="#1E3E7A" BorderThickness="1" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" Height="34" CornerRadius="8" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Box: Einstellungen & Datenschutz (Integriert!) -->
                        <Border Background="#0B152E" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="18" Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚙️" FontSize="16"/>
                                    <TextBlock Text="Konto- &amp; Systemeinstellungen" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="Systemweite Schutzoptionen, Autostart und KI-Assistenz anpassen." FontSize="12" Foreground="#64748B"/>

                                <ToggleSwitch x:Name="AutoStartToggle" Header="Beim Windows-Start automatisch starten &amp; schützen" IsOn="False" Toggled="AutoStartToggle_Toggled" Foreground="#CBD5E1"/>
                                <Border Height="1" Background="#162850"/>
                                <ToggleSwitch x:Name="AIToggle" Header="Locky KI Lern-Tutor für Kinder aktivieren" IsOn="True" Toggled="AIToggle_Toggled" Foreground="#CBD5E1"/>
                            </StackPanel>
                        </Border>

                        <!-- Box: Gefahrenzone (Konto löschen) -->
                        <Border Background="#2A0B13" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="18" Padding="20">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="🗑️" FontSize="16"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Gefahrenzone: Konto löschen" FontSize="14" FontWeight="Bold" Foreground="#F87171"/>
                                            <TextBlock Text="Konto und alle Daten dauerhaft löschen." FontSize="11" Foreground="#FCA5A5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="StartDeleteAccountBtn" Content="Konto löschen" Click="StartDeleteAccount_Click" Background="#991B1B" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Height="34" CornerRadius="8" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Confirmation Code Subpanel -->
                                <StackPanel x:Name="DeleteAccountConfirmPanel" Visibility="Collapsed" Spacing="10" Margin="0,10,0,0">
                                    <TextBlock Text="6-stelliger Bestätigungscode wurde an deine E-Mail gesendet:" FontSize="12" Foreground="#FCA5A5"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBox x:Name="DeleteAccountCodeInput" PlaceholderText="123456" Width="140" Height="36" CornerRadius="8"/>
                                        <Button Content="Endgültig löschen" Click="ConfirmDeleteAccount_Click" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" Height="36" CornerRadius="8"/>
                                        <Button Content="Abbrechen" Click="CancelDeleteAccount_Click" Background="#334155" Foreground="#CBD5E1" Height="36" CornerRadius="8"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DeleteAccountErrorText" Visibility="Collapsed" Foreground="#EF4444" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================== -->
                <!-- 4. 👥 PROFILE PANEL (Exact Bild 4 Design mit Avatar & Tiefem Scrollen) -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelChildren" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="22" Padding="0,0,8,40" MaxWidth="920" HorizontalAlignment="Left">
                        <!-- Header with Add Profile Button -->
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Kinderprofile verwalten" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Richte individuelle Lernziele, Limits und Fächer für jedes Kind ein." FontSize="13" Foreground="#94A3B8"/>
                            </StackPanel>
                            <Button x:Name="AddProfileHeaderBtn" Click="CreateChildButton_Click" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Height="40" CornerRadius="12" Padding="18,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="＋" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Profil hinzufügen" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 🧒 "Deine Kinder" Cards Grid -->
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="👥" FontSize="16"/>
                                <TextBlock Text="Deine Kinder" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>

                            <!-- Horizontal Grid or ItemsControl for Child Cards -->
                            <ItemsControl x:Name="ChildrenItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Futuristic Glass Child Card -->
                                        <Border Width="340" Background="#0B152E" BorderBrush="#1C2F57" BorderThickness="1.5" CornerRadius="20" Padding="20">
                                            <StackPanel Spacing="14">
                                                <!-- Top: Avatar + Name + Badges -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Avatar Border with Glow -->
                                                    <Border Width="64" Height="64" CornerRadius="32" Background="#0369A1" BorderBrush="#38BDF8" BorderThickness="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AvatarEmoji, FallbackValue='👦'}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="8" Height="8" Fill="#10B981"/>
                                                            <TextBlock Text="Online • Aktiv" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{Binding SchoolGrade, ConverterParameter='Klasse {0}'}" FontSize="12" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Tageslimit Progress Bar -->
                                                <StackPanel Spacing="6">
                                                    <Grid>
                                                        <TextBlock Text="Tageslimit" FontSize="12" Foreground="#64748B"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                                            <TextBlock Text="{Binding DailyLimitMinutes}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                                            <TextBlock Text="Min." FontSize="12" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ProgressBar Value="75" Maximum="100" Height="6" CornerRadius="3" Foreground="#0284C7" Background="#162850"/>
                                                </StackPanel>

                                                <!-- Erlaubte Fächer Badges -->
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Erlaubte Fächer" FontSize="12" Foreground="#64748B"/>
                                                    <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                        <TextBlock Text="{Binding AllowedSubjects}" FontSize="11" Foreground="#F59E0B" FontWeight="Bold" TextWrapping="Wrap"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Action Buttons: Bearbeiten, Sperren, Löschen -->
                                                <Grid Margin="0,4,0,0" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="✏️ Bearbeiten" Tag="{Binding}" Click="EditChildProfile_Click" Background="#0F244C" BorderBrush="#1E3E7A" BorderThickness="1" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Height="34" CornerRadius="8" HorizontalAlignment="Stretch"/>
                                                    <Button Grid.Column="1" Content="🔒 Sperren" Tag="{Binding}" Click="LockChildProfile_Click" Background="#3B0713" BorderBrush="#881337" BorderThickness="1" Foreground="#FDA4AF" FontWeight="SemiBold" FontSize="11" Height="34" CornerRadius="8" HorizontalAlignment="Stretch"/>
                                                    <Button Grid.Column="2" Content="🗑️" Tag="{Binding Id}" Click="DeleteChildProfile_Click" Background="Transparent" BorderBrush="#7F1D1D" BorderThickness="1" Foreground="#F87171" FontWeight="Bold" FontSize="12" Width="36" Height="34" CornerRadius="8"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ⚙️ Create/Edit Child Form (Now with Avatar Picker & Deep Scroll!) -->
                        <Border x:Name="CreateChildPanel" Background="#0B152E" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="20" Padding="24" Visibility="Collapsed" MaxWidth="720" HorizontalAlignment="Left">
                            <!-- Deep ScrollViewer with comfortable MaxHeight -->
                            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="18" Padding="0,0,14,20">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="CreateChildTitle" Text="Neues Kinderprofil einrichten" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Passe Vorname, Profilbild, Klassenstufe und Lernfächer an." FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>

                                    <!-- 🎨 Profilbild / Avatar Emoji Auswahl -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Profilbild / Avatar wählen:" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                        <ComboBox x:Name="AvatarComboBox" HorizontalAlignment="Left" Width="240" Height="40" Background="#0E1B38" BorderBrush="#1C2F57" CornerRadius="8" Foreground="#FFFFFF">
                                            <ComboBoxItem Content="👦 Junge (Standard)" Tag="👦" IsSelected="True"/>
                                            <ComboBoxItem Content="👧 Mädchen" Tag="👧"/>
                                            <ComboBoxItem Content="🦁 Löwe" Tag="🦁"/>
                                            <ComboBoxItem Content="🚀 Rakete" Tag="🚀"/>
                                            <ComboBoxItem Content="🦄 Einhorn" Tag="🦄"/>
                                            <ComboBoxItem Content="🎮 Gamer" Tag="🎮"/>
                                            <ComboBoxItem Content="⚽ Fußball" Tag="⚽"/>
                                            <ComboBoxItem Content="🦖 Dino" Tag="🦖"/>
                                            <ComboBoxItem Content="🤖 Roboter" Tag="🤖"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="14">
                                            <TextBox x:Name="ChildNameInput" Header="Vorname des Kindes" PlaceholderText="z.B. Timmy" Background="#0E1B38" BorderBrush="#1C2F57" CornerRadius="8" Foreground="#FFFFFF" Height="58"/>
                                            <TextBox x:Name="ChildGradeInput" Header="Klassenstufe (1 - 13)" PlaceholderText="z.B. 4" InputScope="Number" Background="#0E1B38" BorderBrush="#1C2F57" CornerRadius="8" Foreground="#FFFFFF" Height="58"/>
                                            <ComboBox x:Name="DifficultyComboBox" Header="Lern-Schwierigkeit" HorizontalAlignment="Stretch" Background="#0E1B38" BorderBrush="#1C2F57" CornerRadius="8" Foreground="#FFFFFF" Height="58">
                                                <ComboBoxItem Content="Einfach (Klassen 1-4)" Tag="0" IsSelected="True"/>
                                                <ComboBoxItem Content="Mittel (Klassen 5-8)" Tag="1"/>
                                                <ComboBoxItem Content="Schwer (Klassen 9-13)" Tag="2"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="14">
                                            <TextBox x:Name="DailyLimitInput" Header="Tägliches Zeitlimit (Minuten)" PlaceholderText="z.B. 60" InputScope="Number" Background="#0E1B38" BorderBrush="#1C2F57" CornerRadius="8" Foreground="#FFFFFF" Height="58"/>
                                            <TextBox x:Name="BlockedAppsInput" Header="Blockierte Apps (Optional)" PlaceholderText="z.B. discord;steam;roblox" Background="#0E1B38" BorderBrush="#1C2F57" CornerRadius="8" Foreground="#FFFFFF" Height="58"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fächer-Auswahl -->
                                    <StackPanel x:Name="SubjectsPanel" Spacing="10">
                                        <TextBlock Text="Erlaubte Fächer auswählen (nach offiziellen Fachanforderungen):" FontSize="13" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                        <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="12" Padding="16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox x:Name="SubjectMath" Content="Mathe" Foreground="#FFFFFF" Margin="0,0,10,10" IsChecked="True" Checked="Subject_Checked"/>
                                                <CheckBox x:Name="SubjectGerman" Grid.Column="1" Content="Deutsch" Foreground="#FFFFFF" Margin="0,0,10,10" Checked="Subject_Checked"/>
                                                <CheckBox x:Name="SubjectEnglish" Grid.Column="2" Content="Englisch" Foreground="#FFFFFF" Margin="0,0,10,10" Checked="Subject_Checked"/>
                                                <CheckBox x:Name="SubjectBiology" Grid.Column="3" Content="Biologie" Foreground="#FFFFFF" Margin="0,0,10,10" Checked="Subject_Checked"/>
                                                <CheckBox x:Name="SubjectChemistry" Grid.Column="4" Content="Chemie" Foreground="#FFFFFF" Margin="0,0,10,10" Checked="Subject_Checked"/>

                                                <CheckBox x:Name="SubjectFrench" Grid.Row="1" Content="Französisch" Foreground="#FFFFFF" Margin="0,0,10,0" Checked="Subject_Checked"/>
                                                <CheckBox x:Name="SubjectSpanish" Grid.Row="1" Grid.Column="1" Content="Spanisch" Foreground="#FFFFFF" Margin="0,0,10,0" Checked="Subject_Checked"/>
                                                <CheckBox x:Name="SubjectReligion" Grid.Row="1" Grid.Column="2" Content="Religion" Foreground="#FFFFFF" Margin="0,0,10,0" Checked="Subject_Checked"/>
                                                <CheckBox x:Name="SubjectSport" Grid.Row="1" Grid.Column="3" Content="Sport" Foreground="#FFFFFF" Margin="0,0,10,0" Checked="Subject_Checked"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock x:Name="CreateChildErrorText" Foreground="#EF4444" FontSize="12" Visibility="Collapsed"/>

                                    <Border Height="1" Background="#1C2F57"/>

                                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                                        <Button Content="Abbrechen" Click="CancelCreateChild_Click" Background="Transparent" BorderBrush="#334155" BorderThickness="1" Foreground="#94A3B8" CornerRadius="10" Height="38" Padding="20,0"/>
                                        <Button Content="Profil speichern" Click="SaveNewChildProfile_Click" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="10" Height="38" Padding="24,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Invisible PanelAppBlocker container for code-behind compatibility -->
                <Grid x:Name="PanelAppBlocker" Visibility="Collapsed">
                    <Grid x:Name="AppBlockerOverlay" Visibility="Collapsed"/>
                    <ItemsControl x:Name="RunningAppsList" Visibility="Collapsed"/>
                    <TextBox x:Name="GlobalBlockedAppsInput" Visibility="Collapsed"/>
                    <TextBox x:Name="GlobalBlockedKeywordsInput" Visibility="Collapsed"/>
                    <TextBlock x:Name="AppBlockerSuccessText" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 🎉 Epic Celebration & Unlock Modal Overlay -->
        <Grid x:Name="UnlockCelebrationOverlay" Grid.ColumnSpan="2" Canvas.ZIndex="999" Visibility="Collapsed" Background="#D9050B14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#0B152E" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="28" Padding="36" Width="480" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <Border Background="#0C2548" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="50" Width="88" Height="88" HorizontalAlignment="Center">
                        <TextBlock Text="👑" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock x:Name="CelebrationPlanTitle" Text="🎉 Lifetime Unlimited freigeschaltet!" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Herzlichen Glückwunsch! Du hast nun uneingeschränkten Vollzugriff." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                    <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="16" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="• Unbegrenzte Kinderprofile anlegen" FontSize="13" Foreground="#CBD5E1"/>
                            <TextBlock Text="• Alle Schulfächer freigeschaltet" FontSize="13" Foreground="#CBD5E1"/>
                            <TextBlock Text="• App- &amp; Webblocker mit Schutz aktiviert" FontSize="13" Foreground="#CBD5E1"/>
                            <TextBlock x:Name="CelebrationDurationText" Text="Lebenslanger Zugriff ohne Verlängerung" FontSize="13" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🚀 Jetzt loslegen &amp; Dashboard entdecken" Click="CloseCelebration_Click" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" Height="46" CornerRadius="23" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ℹ️ Plan Downgraded / Reset to Free Overlay Modal -->
        <Grid x:Name="PlanDowngradeOverlay" Grid.ColumnSpan="2" Canvas.ZIndex="999" Visibility="Collapsed" Background="#D9050B14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#0B152E" BorderBrush="#1C2F57" BorderThickness="2" CornerRadius="28" Padding="36" Width="440" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="2" CornerRadius="50" Width="80" Height="80" HorizontalAlignment="Center">
                        <TextBlock Text="🔒" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Konto-Status aktualisiert" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Dein Plan wurde auf das kostenlose Free-Tier angepasst." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                    <Border Background="#0E1B38" BorderBrush="#1C2F57" BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="• Aktiver Plan: Kostenloses Free-Tier" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                            <TextBlock Text="• 1 Kinderprofil &amp; Basis-Lernfächer nutzbar" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Alles klar, verstanden" Click="CloseDowngradeModal_Click" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Height="42" CornerRadius="21" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
