                                            <Button Content="Abbrechen" Click="CancelDeleteAccount_Click" Background="#E2E8F0" Foreground="#475569" CornerRadius="8" Height="36" Padding="14,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DeleteAccountErrorText" Visibility="Collapsed" Foreground="#DC2626" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 🎉 Epic Celebration & Unlock Modal Overlay -->
