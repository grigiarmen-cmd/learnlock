                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#10B981" FontWeight="Bold"/>
                                <TextBlock Text="App- &amp; Webblocker mit Aegis 30+ Schutz aktiviert" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#10B981" FontWeight="Bold"/>
                                <TextBlock Text="Locky KI Lern-Tutor unbegrenzt nutzbar" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#10B981" FontWeight="Bold"/>
                                <TextBlock x:Name="CelebrationDurationText" Text="Lebenslanger Zugriff ohne Verlängerung" FontSize="14" FontWeight="Bold" Foreground="#F97316"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Button Content="🚀 Jetzt loslegen &amp; Dashboard entdecken" Click="CloseCelebration_Click" Background="#F97316" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" Height="50" CornerRadius="25" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
