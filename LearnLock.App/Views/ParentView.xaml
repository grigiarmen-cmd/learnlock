<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LearnLock_App.Views.ParentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="#FDFBF7">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Panel -->
        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Background="#FDFBF7">
            <Grid Padding="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock Text="🔒 LearnLock" FontSize="20" FontWeight="Bold" Foreground="#F97316" Margin="0,0,0,24"/>
                    
                    <Button x:Name="TabDashboard" Content="📊 Dashboard" Click="Tab_Click" Tag="Dashboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="#FFFFFF" Foreground="#2D3748" BorderThickness="0" Margin="0,0,0,6" Height="36" CornerRadius="6"/>
                    <Button x:Name="TabChildren" Content="👦 Kinderprofile" Click="Tab_Click" Tag="Children" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#718096" BorderThickness="0" Margin="0,0,0,6" Height="36" CornerRadius="6"/>
                    <Button x:Name="TabAppBlocker" Content="🚫 App-Sperre" Click="Tab_Click" Tag="AppBlocker" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#718096" BorderThickness="0" Margin="0,0,0,6" Height="36" CornerRadius="6"/>
                    <Button x:Name="TabSettings" Content="⚙️ Einstellungen" Click="Tab_Click" Tag="Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#718096" BorderThickness="0" Margin="0,0,0,6" Height="36" CornerRadius="6"/>
                    <Button x:Name="TabAccount" Content="👤 Mein Konto" Click="Tab_Click" Tag="Account" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#718096" BorderThickness="0" Margin="0,0,0,6" Height="36" CornerRadius="6"/>
                </StackPanel>

                <Button Grid.Row="2" Content="🚪 Abmelden" Click="Logout_Click" HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="#E2E8F0" Foreground="#2D3748" CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1" Padding="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Update Banner -->
            <Border x:Name="UpdateBanner" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitleText" Text="🎉 Ein neues Update ist verfügbar!" FontWeight="Bold" Foreground="#92400E" FontSize="16"/>
                        <TextBlock x:Name="UpdateDescText" Text="Es gibt eine neue Version von LearnLock mit Verbesserungen und neuen Funktionen." Foreground="#B45309" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="InstallUpdateBtn" Grid.Column="1" Content="Jetzt installieren" Background="#F59E0B" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="20,10" Click="InstallUpdateBtn_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- 📊 Dashboard Panel -->
                <ScrollViewer x:Name="PanelDashboard" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24" Background="#FDFBF7">
                    
                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="#2D3748"/>
                            <TextBlock Text="Behalte den Überblick über Nutzungszeiten und App-Sperren" FontSize="12" Foreground="#718096" Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <Button x:Name="AddProfileHeaderBtn" Grid.Column="1" Content="+ Profil hinzufügen" Click="CreateChildButton_Click" Background="#F97316" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="20" Height="40" Padding="16,0" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="Einstellungen" Click="Tab_Click" Tag="Settings" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#718096" CornerRadius="20" Height="40" Padding="16,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Top 4 KPI Cards -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Solid Accent -->
                        <Border Background="#F97316" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Verfügbare Spielzeit" FontSize="12" Foreground="#DBEAFE" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatTotalTimeText" Text="0 Std. 0 Min." FontSize="24" FontWeight="Bold" Foreground="#2D3748"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#F97316"/>
                                    <TextBlock Text="Gesamtes Guthaben" FontSize="10" Foreground="#BFDBFE"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2 -->
                        <Border Grid.Column="1" Background="#151E32" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Durchschn. Tageslimit" FontSize="12" Foreground="#718096" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatDailyAvgText" Text="0 Std. 0 Min." FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE909;" FontSize="10" Foreground="#10B981"/>
                                    <TextBlock Text="Pro Kind konfiguriert" FontSize="10" Foreground="#718096"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3 -->
                        <Border Grid.Column="2" Background="#151E32" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Aktive App-Sperren" FontSize="12" Foreground="#718096" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatActiveLimitsText" Text="0 Apps" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#F97316"/>
                                    <TextBlock Text="Lokal geblockt" FontSize="10" Foreground="#718096"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 4 -->
                        <Border Grid.Column="3" Background="#151E32" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Aktive Web-Filter" FontSize="12" Foreground="#718096" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatKeywordsText" Text="0 Stichwörter" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="10" Foreground="#F43F5E"/>
                                    <TextBlock Text="Inkl. Kinderspezifisch" FontSize="10" Foreground="#718096"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Middle Row: Analytics, Reminders, Project/Apps -->
                    <Grid ColumnSpacing="16" Height="280">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Bar Chart: Aktivitätsverlauf -->
                        <Border Background="#151E32" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="16" VerticalAlignment="Stretch">
                                <TextBlock Text="Aktivitätsverlauf" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748"/>
                                <!-- Fake Bar Chart matching the image's rounded solid bars + striped bars -->
                                <Grid Height="180" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="10">
                                        <Border Width="30" Height="80" Background="#FDFBF7" CornerRadius="15"/>
                                        <TextBlock Text="S" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="10">
                                        <Border Width="30" Height="110" Background="#10B981" CornerRadius="15"/>
                                        <TextBlock Text="M" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="10">
                                        <Border Width="30" Height="140" Background="#34D399" CornerRadius="15"/>
                                        <TextBlock Text="T" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="10">
                                        <Border Width="30" Height="160" Background="#064E3B" CornerRadius="15"/>
                                        <TextBlock Text="W" FontSize="12" Foreground="#2D3748" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="10">
                                        <Border Width="30" Height="100" Background="#FDFBF7" CornerRadius="15"/>
                                        <TextBlock Text="T" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="10">
                                        <Border Width="30" Height="70" Background="#FDFBF7" CornerRadius="15"/>
                                        <TextBlock Text="F" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="10">
                                        <Border Width="30" Height="90" Background="#FDFBF7" CornerRadius="15"/>
                                        <TextBlock Text="S" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Reminders / Current Status -->
                        <Border Grid.Column="1" Background="#151E32" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Systemstatus" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748"/>
                                <TextBlock x:Name="DashStatusTitle" Text="Keine aktive Sitzung" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,10,0,0"/>
                                <TextBlock x:Name="DashStatusChild" Text="Kind: -" FontSize="12" Foreground="#718096"/>
                                <TextBlock x:Name="DashStatusTime" Text="Verbleibende Zeit: -" FontSize="12" Foreground="#718096"/>
                                
                                <Button Content="Alle Sperren aufheben" Click="CancelCreateChild_Click" Background="#F97316" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="20" Height="40" HorizontalAlignment="Stretch" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Project / App List -->
                        <Border Grid.Column="2" Background="#151E32" CornerRadius="16" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Regeln" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ Neu" Click="Tab_Click" Tag="AppBlocker" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#718096" CornerRadius="12" Height="28" Padding="10,0" FontSize="10"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="DashActiveRulesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE715;" FontSize="16" Foreground="#F97316"/>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                                                        <TextBlock Text="Blockiert" FontSize="10" Foreground="#718096"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bottom Row: Team Collaboration, Progress, Time Tracker -->
                    <Grid ColumnSpacing="16" Height="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Team Collaboration / Kinderprofile -->
                        <Border Background="#151E32" CornerRadius="16" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kinderprofile" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ Kind hinzufügen" Click="Tab_Click" Tag="Children" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#718096" CornerRadius="12" Height="28" Padding="10,0" FontSize="10"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="DashboardChildrenList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="#FDFBF7">
                                                        <FontIcon Glyph="&#xE77b;" FontSize="14" Foreground="#718096"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                        <TextBlock Text="Profil aktiv" FontSize="10" Foreground="#718096"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#064E3B" CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                                                        <TextBlock Text="OK" FontSize="10" Foreground="#34D399" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Project Progress / Verbleibende Spielzeit -->
                        <Border Grid.Column="1" Background="#151E32" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Guthaben genutzt" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748"/>
                                <!-- Fake Donut Chart, updated dynamically if needed -->
                                <Grid Height="120" Margin="0,10,0,0">
                                    <Ellipse Width="120" Height="120" StrokeThickness="16" Stroke="#1E293B" VerticalAlignment="Center"/>
                                    <Ellipse Width="120" Height="120" StrokeThickness="16" Stroke="#2563EB" StrokeDashArray="2 6" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="DashProgressText" Text="0%" FontSize="28" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Im Schnitt" FontSize="10" Foreground="#718096" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="#F97316"/>
                                        <TextBlock Text="Genutzt" FontSize="10" Foreground="#718096"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="#1E293B"/>
                                        <TextBlock Text="Offen" FontSize="10" Foreground="#718096"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Time Tracker / Aktiver Timer -->
                        <Border Grid.Column="2" Background="#F97316" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="16" VerticalAlignment="Center">
                                <TextBlock Text="Aktivste Restzeit" FontSize="14" FontWeight="SemiBold" Foreground="#DBEAFE"/>
                                <TextBlock x:Name="DashTimerText" Text="00:00:00" FontSize="36" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center" Margin="0,10,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                    <Border Width="40" Height="40" Background="#FFFFFF" CornerRadius="20">
                                        <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="#F97316"/>
                                    </Border>
                                    <Border Width="40" Height="40" Background="#EF4444" CornerRadius="20">
                                        <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="#2D3748"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- 2. KINDERPROFILE TAB PANEL (MODERN REDESIGN) -->
            <ScrollViewer x:Name="PanelChildren" Visibility="Collapsed">
                <StackPanel Spacing="32" Background="#FDFBF7" Padding="0,0,0,40">
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Kinderprofile verwalten" FontSize="28" FontWeight="Bold" Foreground="#2D3748"/>
                            <TextBlock Text="Richte individuelle Limits und Fächer für jedes Kind ein." FontSize="14" Foreground="#718096"/>
                        </StackPanel>
                        <Button x:Name="AddProfileDashboardBtn" Grid.Column="1" Content="+ Profil hinzufügen" Click="CreateChildButton_Click" Background="#F97316" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="20" Height="44" Padding="20,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Active Profiles Grid -->
                    <ItemsControl x:Name="ChildrenItemsControl">
                        <!-- We use a WrapPanel for a card grid layout -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,24,24" Width="340">
                                    <Border BorderBrush="#00FFFF" BorderThickness="2" CornerRadius="24" Padding="20">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#3000FFFF" Offset="0"/>
                                                <GradientStop Color="#00151E32" Offset="0.3"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Spacing="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <Grid>
                                                    <Border Width="72" Height="72" CornerRadius="36" Background="#FDFBF7" BorderBrush="#38BDF8" BorderThickness="2" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE77B;" FontSize="32" Foreground="#E2E8F0"/>
                                                    </Border>
                                                    <Ellipse Width="16" Height="16" Fill="#10B981" Stroke="#151E32" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"/>
                                                </Grid>
                                                
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="#10B981"/>
                                                        <TextBlock Text="Online • Active" FontSize="11" Foreground="#10B981"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" Foreground="#2D3748" Margin="0,2,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Klasse:" FontSize="13" Foreground="#718096"/>
                                                        <TextBlock Text="{Binding SchoolGrade}" FontSize="13" Foreground="#718096"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Erlaubte Fächer" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,8">
                                                    <TextBlock Text="{Binding AllowedSubjects}" FontSize="12" Foreground="#F97316" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Tageslimit" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                                <ProgressBar Value="70" Maximum="100" Height="8" CornerRadius="4" Foreground="#F97316" Background="#E2E8F0"/>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Limit (Min):" FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding DailyLimitMinutes}" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="App-Nutzung" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="32" Height="32" CornerRadius="8" Background="#EF4444">
                                                            <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="White"/>
                                                        </Border>
                                                        <Border Width="32" Height="32" CornerRadius="8" Background="#F59E0B">
                                                            <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <TextBlock Text="Fokus-Score: 92%" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                                    <TextBlock Text="〰〰📈" FontSize="18" Foreground="#F97316" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <Button Content="✏️ Edit" Tag="{Binding}" Click="EditChildProfile_Click" Background="#33FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" Foreground="#2D3748" FontWeight="SemiBold" CornerRadius="12" Height="36" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Content="🔒 Lock" Tag="{Binding}" Click="LockChildProfile_Click" Background="#40FF0000" BorderBrush="#80FF0000" BorderThickness="1" Foreground="#FF8080" FontWeight="SemiBold" CornerRadius="12" Height="36" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                                                <Button Grid.Column="2" Content="🗑️ Delete" Tag="{Binding Id}" Click="DeleteChildProfile_Click" Background="Transparent" BorderBrush="#F43F5E" BorderThickness="1" Foreground="#F43F5E" FontWeight="SemiBold" CornerRadius="12" Height="36"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
