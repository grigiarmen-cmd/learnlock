                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🛡️" FontSize="14"/>
                                <TextBlock Text="Sicher bezahlen" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
