                    </StackPanel>

                    <!-- Unlocked Features List -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#10B981" FontWeight="Bold"/>
                                <TextBlock Text="Unbegrenzte Kinderprofile anlegen" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#10B981" FontWeight="Bold"/>
