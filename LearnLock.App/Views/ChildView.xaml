<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LearnLock_App.Views.ChildView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="#FDFBF7">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="👦 LearnLock Spielzeit" FontSize="20" FontWeight="Bold" Foreground="#F97316"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
            <TextBlock Text="Verbleibende Spielzeit:" FontSize="18" Foreground="#718096" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TimerText" Text="15:00" FontSize="72" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
            
            <Border Background="#1a1a1a" BorderBrush="#2a2a2a" BorderThickness="1" CornerRadius="12" Padding="20" Width="360">
                <StackPanel Spacing="8">
                    <TextBlock Text="Hinweis:" FontWeight="Bold" Foreground="#2D3748"/>
                    <TextBlock Text="Löse Aufgaben, um mehr Spielzeit zu erhalten. Sobald die Zeit abläuft, wird das System automatisch gesperrt!" Foreground="#718096" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="🎮 Jetzt am PC spielen / Fenster minimieren" Click="PlayNow_Click" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Height="36"/>
            <Button Content="Zusätzliche Aufgaben lösen" Click="SolveMore_Click" Background="#F97316" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Height="36"/>
            <Button Content="Bildschirm sofort sperren" Click="LockNow_Click" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Height="36"/>
        </StackPanel>
    </Grid>
</Page>


