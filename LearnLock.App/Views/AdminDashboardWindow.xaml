<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LearnLock_App.Views.AdminDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LearnLock Global Command Center">

    <Grid Background="#0A0F1D" Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation & Branding Header -->
        <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="18" Padding="24,18" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Background="#F97316" CornerRadius="10" Width="36" Height="36">
                            <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="LearnLock Master Control" FontSize="22" FontWeight="Bold" Foreground="#F9FAFB"/>
                        <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="● LIVE CLOUD &amp; STRIPE CONNECTED" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Echtzeit-Synchronisierung aller weltweiten Kundenkonten, Plan-Zuweisung und Direktnachrichten." FontSize="13" Foreground="#9CA3AF"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 Liste aktualisieren" Click="RefreshUsers_Click" Background="#374151" Foreground="#F9FAFB" FontWeight="SemiBold" BorderThickness="0" CornerRadius="16" Height="38" Padding="18,0"/>
            </Grid>
        </Border>

        <!-- Split View Content Area -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: User Table -->
            <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="18" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Registrierte Kunden &amp; Abonnenten" FontSize="16" FontWeight="Bold" Foreground="#F9FAFB"/>
                        <TextBlock x:Name="UserCountText" Text="Lade Kunden..." FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="UsersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- User Details -->
                                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Email}" FontSize="15" FontWeight="Bold" Foreground="#F9FAFB"/>
                                                    <Border Background="{Binding BadgeColor}" CornerRadius="8" Padding="8,2">
                                                        <TextBlock Text="{Binding Tier}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#9CA3AF"/>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="👑 Lifetime" Click="UpgradeUser_Click" Tag="{Binding Email}" Background="#F97316" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Height="34" CornerRadius="17" Padding="12,0"/>
                                                <Button Content="⛔ Auf Free" Click="DowngradeUser_Click" Tag="{Binding Email}" Background="#4B5563" Foreground="#F9FAFB" FontSize="12" Height="34" CornerRadius="17" Padding="12,0"/>
                                                <Button Content="✉️ Mail" Click="SelectUserEmail_Click" Tag="{Binding Email}" Background="#2563EB" Foreground="#FFFFFF" FontSize="12" Height="34" CornerRadius="17" Padding="12,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Column: Direct Email Composer & Manual Override -->
            <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="18" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="✉️ Nachricht an Kunden senden" FontSize="16" FontWeight="Bold" Foreground="#F9FAFB"/>
                        
                        <TextBox x:Name="MailTargetEmail" Header="Empfänger-E-Mail" PlaceholderText="kunde@domain.de" Background="#1F2937" BorderBrush="#374151" Foreground="#F9FAFB" Height="58"/>
                        <TextBox x:Name="MailSubject" Header="Betreff" PlaceholderText="Information zu deinem LearnLock Plan" Background="#1F2937" BorderBrush="#374151" Foreground="#F9FAFB" Height="58"/>
                        <TextBox x:Name="MailMessage" Header="Nachricht" PlaceholderText="Hallo, wir haben dein Konto überprüft..." AcceptsReturn="True" TextWrapping="Wrap" Height="120" Background="#1F2937" BorderBrush="#374151" Foreground="#F9FAFB"/>

                        <Button x:Name="SendMailBtn" Content="🚀 E-Mail jetzt senden" Click="SendEmail_Click" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Height="42" CornerRadius="21" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="MailStatusText" Foreground="#10B981" FontSize="12" Visibility="Collapsed" HorizontalAlignment="Center"/>

                        <Border Height="1" Background="#1F2937" Margin="0,6"/>

                        <!-- Direct Plan Override Tool -->
                        <TextBlock Text="⚡ Sofortige Lizenz-Zuweisung" FontSize="15" FontWeight="Bold" Foreground="#F9FAFB"/>
                        <TextBox x:Name="ManualEmailInput" Header="Kunden-E-Mail" PlaceholderText="beliebige@email.de" Background="#1F2937" BorderBrush="#374151" Foreground="#F9FAFB" Height="58"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="👑 Lifetime schenken" Click="ManualLifetime_Click" Background="#F97316" Foreground="#FFFFFF" FontWeight="Bold" Height="40" CornerRadius="20" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="1" Content="❌ Free beschränken" Click="ManualFree_Click" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" Height="40" CornerRadius="20" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
