// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  tier          String    @default("Free") // "Free", "Basic", "Pro", "Ultra"
  accounts      Account[]
  sessions      Session[]
  children      ChildProfile[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChildProfile {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  age                 Int?
  avatarPath          String?
  dailyLimitSeconds   Int      @default(3600)
  currentTimeBalance  Int      @default(3600)
  blockedApps         String?  // comma-separated list of executables
  subjects            String?  // comma-separated list of subjects
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
